<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MemeCoin Creator</title>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; }

body { background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); min-height: 100vh; color: white; }

.screen { display: none; min-height: 100vh; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center; }
.screen.active { display: flex; }

h1 { font-size: 3.5rem; margin-bottom: 20px; background: linear-gradient(90deg, #00f5ff, #b537f2, #ff00aa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.subtitle { color: #aaa; margin-bottom: 40px; font-size: 1.2rem; }

.btn-main { background: linear-gradient(90deg, #7b2ff7, #f107a3); border: none; color: white; font-size: 1.5rem; font-weight: bold; padding: 20px 60px; border-radius: 50px; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
.btn-main:hover { transform: scale(1.05); box-shadow: 0 0 30px rgba(241, 7, 163, 0.6); }

.form-box { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; padding: 40px; width: 100%; max-width: 480px; text-align: left; }
.form-box h2 { text-align: center; margin-bottom: 25px; }

label { display: block; margin-bottom: 6px; color: #ccc; font-size: 0.9rem; }

input[type="text"], input[type="number"], textarea {
  width: 100%; padding: 14px; margin-bottom: 20px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.4); color: white; font-size: 1rem;
}
input:focus, textarea:focus { outline: 2px solid #7b2ff7; }
textarea { resize: vertical; min-height: 90px; }
input[type="file"] { display: none; }

.upload-box { border: 2px dashed #7b2ff7; border-radius: 10px; padding: 25px; text-align: center; cursor: pointer; margin-bottom: 20px; }
.upload-box:hover { background: rgba(123,47,247,0.15); }
.upload-box img { max-width: 120px; max-height: 120px; border-radius: 12px; margin-top: 10px; }

.btn-next { width: 100%; padding: 18px; font-size: 1.4rem; font-weight: bold; color: #000; background: #00ff88; border: none; border-radius: 12px; cursor: pointer; }

.error { color: #ff5c5c; margin-bottom: 15px; display: none; text-align: center; }

.btn-phantom { display: flex; align-items: center; gap: 15px; background: #4e44ce; border: none; color: white; font-size: 1.3rem; font-weight: bold; padding: 20px 50px; border-radius: 15px; cursor: pointer; transition: transform 0.2s; }
.btn-phantom:hover { transform: scale(1.05); box-shadow: 0 0 25px rgba(78,68,206,0.7); }

.wallet-info { margin-top: 25px; padding: 15px 25px; background: rgba(0,255,136,0.1); border: 1px solid #00ff88; border-radius: 12px; color: #00ff88; display: none; word-break: break-all; }

.payment-box { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; padding: 40px; width: 100%; max-width: 480px; }
.price { font-size: 3rem; font-weight: bold; color: #00ff88; margin: 20px 0; }
.payment-summary { background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px; margin: 20px 0; text-align: left; font-size: 0.95rem; line-height: 1.7; }
.payment-note { color: #aaa; font-size: 0.85rem; line-height: 1.5; margin-top: 15px; text-align: center; }

.btn-pay { width: 100%; padding: 18px; border: none; border-radius: 12px; background: linear-gradient(90deg, #00ff88, #00cfff); color: #000; font-size: 1.2rem; font-weight: bold; cursor: pointer; margin-top: 20px; }
.btn-pay:disabled { opacity: 0.5; cursor: not-allowed; }

.payment-error { color: #ff5c5c; margin: 15px 0; }
.success { color: #00ff88; margin-top: 20px; word-break: break-all; font-size: 0.95rem; line-height: 1.8; }
.success a { color: #00cfff; }
.status { color: #ffcc00; margin-top: 15px; font-size: 0.95rem; }
</style>
</head>

<body>

<!-- ============ PANTALLA 1 ============ -->
<div class="screen active" id="screen1">
  <h1>🪙 MemeCoin Creator</h1>
  <p class="subtitle">Crea tu propia memecoin en Solana en segundos</p>
  <button class="btn-main" onclick="goTo(2)">🚀 CREATE MEMECOIN</button>
</div>

<!-- ============ PANTALLA 2: FORMULARIO ============ -->
<div class="screen" id="screen2">
  <div class="form-box">
    <h2>📝 Datos de tu Memecoin</h2>

    <label>Nombre de la memecoin (máx. 32 caracteres)</label>
    <input type="text" id="coinName" maxlength="32" placeholder="Ej: PepeMoon">

    <label>Símbolo (máx. 10 caracteres)</label>
    <input type="text" id="coinSymbol" maxlength="10" placeholder="Ej: PMOON">

    <label>Supply total</label>
    <input type="number" id="coinSupply" min="1" step="1" value="1000000000">

    <label>Imagen</label>
    <label class="upload-box" for="coinImage">
      <span id="uploadText">📷 Haz clic para subir imagen</span>
      <img id="preview" style="display:none;">
    </label>
    <input type="file" id="coinImage" accept="image/*">

    <label>Descripción</label>
    <textarea id="coinDesc" placeholder="Describe tu memecoin..."></textarea>

    <p class="error" id="errorMsg">⚠️ Rellena todos los campos correctamente</p>

    <button class="btn-next" onclick="nextStep()">NEXT ➜</button>
  </div>
</div>

<!-- ============ PANTALLA 3: WALLET ============ -->
<div class="screen" id="screen3">
  <h1 style="font-size:2.5rem;">Conecta tu Wallet</h1>
  <p class="subtitle">Conecta tu wallet Phantom para continuar</p>
  <button class="btn-phantom" onclick="connectPhantom()">👻 Connect Phantom</button>
  <div class="wallet-info" id="walletInfo"></div>
</div>

<!-- ============ PANTALLA 4: PAGO + CREACIÓN ============ -->
<div class="screen" id="screen4">
  <div class="payment-box">
    <h2>🚀 Lanzar Memecoin</h2>

    <div class="price">0.15 SOL</div>

    <div class="payment-summary">
      Al pulsar "Crear y pagar" ocurrirá todo en una sola transacción:<br><br>
      🪙 Se crea tu token en la red Solana<br>
      🖼️ Se registran el nombre, símbolo e imagen<br>
      💰 Recibes todo el supply en tu wallet<br>
      🔒 Se bloquea el supply (nadie podrá crear más)<br>
      💎 0,15 SOL de comisión del servicio<br><br>
      <span style="color:#aaa;">+ costes de red de Solana (~0,02 SOL)</span>
    </div>

    <p class="payment-note">Phantom te mostrará la transacción completa para revisarla antes de aprobarla.</p>

    <p class="payment-error" id="paymentError"></p>
    <p class="status" id="paymentStatus"></p>

    <button class="btn-pay" id="payButton" onclick="createAndPay()">
      🚀 Crear memecoin · 0,15 SOL
    </button>

    <p class="success" id="paymentSuccess" style="display:none;"></p>
  </div>
</div>

<script src="https://unpkg.com/@solana/web3.js@1.98.4/lib/index.iife.min.js"></script>

<script>
/* =====================================================
   CONFIG — EDITA AQUÍ
   ===================================================== */

// 'devnet' para pruebas gratis · 'mainnet-beta' para producción
const CLUSTER = 'mainnet-beta';

// Tu wallet (recibe la comisión de 0,15 SOL). NUNCA claves privadas.
const RECIPIENT = "ALYvVwz4iWvurRhR654BxUey6w9UYoAmdLzn7JYQVGS2";

// Comisión del servicio
const FEE_SOL = 0.15;

// Decimales del token (6 es habitual en memecoins)
const DECIMALS = 6;

// JWT de Pinata (gratis en pinata.cloud → API Keys → New Key)
const PINATA_JWT = "PEGAR_AQUI_TU_JWT_DE_PINATA";

const IPFS_GATEWAY = "https://gateway.pinata.cloud/ipfs/";


/* =====================================================
   CONSTANTES DE SOLANA
   ===================================================== */
const TOKEN_PROGRAM_ID = new solanaWeb3.PublicKey("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");
const ATA_PROGRAM_ID   = new solanaWeb3.PublicKey("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL");
const METADATA_PROGRAM = new solanaWeb3.PublicKey("metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s");


/* =====================================================
   NAVEGACIÓN
   ===================================================== */
function goTo(n) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen' + n).classList.add('active');
}


/* =====================================================
   PREVIEW IMAGEN
   ===================================================== */
const fileInput  = document.getElementById('coinImage');
const preview    = document.getElementById('preview');
const uploadText = document.getElementById('uploadText');

fileInput.addEventListener('change', function() {
  if (this.files && this.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      preview.src = e.target.result;
      preview.style.display = 'block';
      uploadText.textContent = '✅ Imagen cargada (clic para cambiar)';
    };
    reader.readAsDataURL(this.files[0]);
  }
});


/* =====================================================
   VALIDACIÓN
   ===================================================== */
function nextStep() {
  const name   = document.getElementById('coinName').value.trim();
  const symbol = document.getElementById('coinSymbol').value.trim();
  const supply = document.getElementById('coinSupply').value.trim();
  const desc   = document.getElementById('coinDesc').value.trim();
  const hasImg = fileInput.files.length > 0;
  const errorMsg = document.getElementById('errorMsg');

  const ok = name && symbol && desc && hasImg
          && name.length <= 32
          && symbol.length <= 10
          && /^[1-9][0-9]*$/.test(supply);

  if (!ok) { errorMsg.style.display = 'block'; return; }
  errorMsg.style.display = 'none';
  goTo(3);
}


/* =====================================================
   CONECTAR PHANTOM
   ===================================================== */
async function connectPhantom() {
  const info = document.getElementById('walletInfo');
  const provider = window.phantom?.solana || window.solana;

  if (!provider || !provider.isPhantom) {
    alert('Phantom no está instalada. Abriendo la página oficial.');
    window.open('https://phantom.app/', '_blank');
    return;
  }

  try {
    const response = await provider.connect();
    info.style.display = 'block';
    info.textContent = '✅ Wallet conectada: ' + response.publicKey.toString();
    setTimeout(() => goTo(4), 800);
  } catch (e) {
    alert('Conexión rechazada por el usuario.');
  }
}


/* =====================================================
   HELPERS
   ===================================================== */
const enc = new TextEncoder();

function joinBytes(...arrs) {
  const total = arrs.reduce((n, a) => n + a.length, 0);
  const out = new Uint8Array(total);
  let o = 0;
  for (const a of arrs) { out.set(a, o); o += a.length; }
  return out;
}
function u32le(n) { const b = new Uint8Array(4); new DataView(b.buffer).setUint32(0, n, true); return b; }
function u16le(n) { const b = new Uint8Array(2); new DataView(b.buffer).setUint16(0, n, true); return b; }
function u64le(n) { const b = new Uint8Array(8); new DataView(b.buffer).setBigUint64(0, n, true); return b; }
function borshStr(s) { const b = enc.encode(s); return joinBytes(u32le(b.length), b); }

function getATA(owner, mint) {
  return solanaWeb3.PublicKey.findProgramAddressSync(
    [owner.toBytes(), TOKEN_PROGRAM_ID.toBytes(), mint.toBytes()],
    ATA_PROGRAM_ID
  )[0];
}


/* =====================================================
   SUBIR A IPFS (PINATA)
   ===================================================== */
async function uploadImageToIPFS(file) {
  const fd = new FormData();
  fd.append('file', file);
  const res = await fetch('https://api.pinata.cloud/pinning/pinFileToIPFS', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + PINATA_JWT },
    body: fd
  });
  if (!res.ok) throw new Error('Error subiendo la imagen a IPFS');
  const json = await res.json();
  return IPFS_GATEWAY + json.IpfsHash;
}

async function uploadMetadataToIPFS(metadata) {
  const res = await fetch('https://api.pinata.cloud/pinning/pinJSONToIPFS', {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + PINATA_JWT,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ pinataContent: metadata })
  });
  if (!res.ok) throw new Error('Error subiendo los metadatos a IPFS');
  const json = await res.json();
  return IPFS_GATEWAY + json.IpfsHash;
}


/* =====================================================
   CREAR TOKEN + COBRAR (todo en una transacción)
   ===================================================== */
async function createAndPay() {
  const errorEl   = document.getElementById('paymentError');
  const statusEl  = document.getElementById('paymentStatus');
  const successEl = document.getElementById('paymentSuccess');
  const button    = document.getElementById('payButton');

  errorEl.textContent = '';
  statusEl.textContent = '';
  successEl.style.display = 'none';

  if (PINATA_JWT.includes('PEGAR_AQUI')) {
    errorEl.textContent = '⚠️ Configuración pendiente: falta la clave IPFS (bloque CONFIG del código).';
    return;
  }

  const provider = window.phantom?.solana || window.solana;
  if (!provider || !provider.isPhantom) { errorEl.textContent = '⚠️ Phantom no está instalada.'; return; }
  if (!provider.publicKey) { errorEl.textContent = '⚠️ Primero debes conectar tu wallet.'; return; }

  const name   = document.getElementById('coinName').value.trim();
  const symbol = document.getElementById('coinSymbol').value.trim();
  const supply = document.getElementById('coinSupply').value.trim();
  const desc   = document.getElementById('coinDesc').value.trim();

  try {
    button.disabled = true;

    /* ---------- 1. SUBIR IMAGEN Y METADATOS ---------- */
    button.textContent = '⏳ Subiendo imagen...';
    const imageUri = await uploadImageToIPFS(fileInput.files[0]);

    button.textContent = '⏳ Subiendo metadatos...';
    const metadataUri = await uploadMetadataToIPFS({ name, symbol, description: desc, image: imageUri });

    /* ---------- 2. PREPARAR TRANSACCIÓN ---------- */
    button.textContent = '⏳ Preparando transacción...';

    const connection = new solanaWeb3.Connection(solanaWeb3.clusterApiUrl(CLUSTER), 'confirmed');
    const user = provider.publicKey;
    const mint = solanaWeb3.Keypair.generate();     // nueva dirección del token
    const ata  = getATA(user, mint);                // cuenta del usuario para el token

    const tx = new solanaWeb3.Transaction();

    // (a) Crear la cuenta del mint
    const mintRent = await connection.getMinimumBalanceForRentExemption(82);
    tx.add(solanaWeb3.SystemProgram.createAccount({
      fromPubkey: user,
      newAccountPubkey: mint.publicKey,
      lamports: mintRent,
      space: 82,
      programId: TOKEN_PROGRAM_ID
    }));

    // (b) Inicializar el mint (sin autoridad de congelación)
    tx.add(new solanaWeb3.TransactionInstruction({
      programId: TOKEN_PROGRAM_ID,
      keys: [
        { pubkey: mint.publicKey, isSigner: false, isWritable: true },
        { pubkey: solanaWeb3.SYSVAR_RENT_PUBKEY, isSigner: false, isWritable: false }
      ],
      data: joinBytes(Uint8Array.of(0, DECIMALS), user.toBytes(), Uint8Array.of(0))
    }));

    // (c) Crear la cuenta asociada del usuario
    tx.add(new solanaWeb3.TransactionInstruction({
      programId: ATA_PROGRAM_ID,
      keys: [
        { pubkey: user,          isSigner: true,  isWritable: true },
        { pubkey: ata,           isSigner: false, isWritable: true },
        { pubkey: user,          isSigner: false, isWritable: false },
        { pubkey: mint.publicKey,isSigner: false, isWritable: false },
        { pubkey: solanaWeb3.SystemProgram.programId, isSigner: false, isWritable: false },
        { pubkey: TOKEN_PROGRAM_ID, isSigner: false, isWritable: false }
      ],
      data: Uint8Array.of(1) // CreateIdempotent
    }));

    // (d) Mintear todo el supply al usuario
    const rawAmount = BigInt(supply) * (10n ** BigInt(DECIMALS));
    tx.add(new solanaWeb3.TransactionInstruction({
      programId: TOKEN_PROGRAM_ID,
      keys: [
        { pubkey: mint.publicKey, isSigner: false, isWritable: true },
        { pubkey: ata,            isSigner: false, isWritable: true },
        { pubkey: user,           isSigner: true,  isWritable: false }
      ],
      data: joinBytes(Uint8Array.of(7), u64le(rawAmount))
    }));

    // (e) Metadatos (nombre, símbolo, imagen) — estándar Metaplex
    const metadataPda = solanaWeb3.PublicKey.findProgramAddressSync(
      [enc.encode('metadata'), METADATA_PROGRAM.toBytes(), mint.publicKey.toBytes()],
      METADATA_PROGRAM
    )[0];
    tx.add(new solanaWeb3.TransactionInstruction({
      programId: METADATA_PROGRAM,
      keys: [
        { pubkey: metadataPda,   isSigner: false, isWritable: true },
        { pubkey: mint.publicKey,isSigner: false, isWritable: true },
        { pubkey: user,          isSigner: true,  isWritable: false },
        { pubkey: user,          isSigner: true,  isWritable: true  },
        { pubkey: user,          isSigner: false, isWritable: false },
        { pubkey: solanaWeb3.SystemProgram.programId, isSigner: false, isWritable: false }
      ],
      data: joinBytes(
        Uint8Array.of(33),          // CreateMetadataAccountV3
        borshStr(name),
        borshStr(symbol),
        borshStr(metadataUri),
        u16le(0),                   // royalties: 0
        Uint8Array.of(0),           // creators: ninguno
        Uint8Array.of(0),           // collection: ninguna
        Uint8Array.of(0),           // uses: ninguno
        Uint8Array.of(1),           // mutable: sí
        Uint8Array.of(0)            // collectionDetails: ninguno
      )
    }));

    // (f) Revocar autoridad de mint → supply fijo para siempre
    tx.add(new solanaWeb3.TransactionInstruction({
      programId: TOKEN_PROGRAM_ID,
      keys: [
        { pubkey: mint.publicKey, isSigner: false, isWritable: true },
        { pubkey: user,           isSigner: true,  isWritable: false }
      ],
      data: Uint8Array.of(6, 0, 0) // SetAuthority / tipo MintTokens / nueva: ninguna
    }));

    // (g) Comisión del servicio
    tx.add(solanaWeb3.SystemProgram.transfer({
      fromPubkey: user,
      toPubkey: new solanaWeb3.PublicKey(RECIPIENT),
      lamports: Math.round(FEE_SOL * solanaWeb3.LAMPORTS_PER_SOL)
    }));

    /* ---------- 3. FIRMAR Y ENVIAR ---------- */
    button.textContent = '⏳ Aprueba en Phantom...';
    statusEl.textContent = 'Revisa la transacción en Phantom antes de aprobar.';

    const { blockhash, lastValidBlockHeight } = await connection.getLatestBlockhash();
    tx.recentBlockhash = blockhash;
    tx.feePayer = user;
    tx.partialSign(mint); // el mint firma; Phantom pone la firma del usuario

    const { signature } = await provider.signAndSendTransaction(tx);

    button.textContent = '⏳ Confirmando...';
    await connection.confirmTransaction({ signature, blockhash, lastValidBlockHeight }, 'confirmed');

    /* ---------- 4. ÉXITO ---------- */
    statusEl.textContent = '';
    successEl.style.display = 'block';
    successEl.innerHTML =
      '✅ ¡Tu memecoin está creada y el supply está en tu wallet!<br><br>' +
      '🪙 Token: <a href="https://solscan.io/token/' + mint.publicKey.toString() + (CLUSTER === 'devnet' ? '?cluster=devnet' : '') +
      '" target="_blank">' + mint.publicKey.toString() + '</a><br>' +
      '🔗 Transacción: <a href="https://solscan.io/tx/' + signature + (CLUSTER === 'devnet' ? '?cluster=devnet' : '') +
      '" target="_blank">ver en Solscan</a>';

    button.textContent = '✅ Completado';

  } catch (e) {
    console.error(e);
    statusEl.textContent = '';
    errorEl.textContent = '❌ ' + (e.message && e.message.includes('IPFS')
      ? e.message
      : 'El pago fue rechazado o la transacción no pudo completarse.');
    button.disabled = false;
    button.textContent = '🚀 Crear memecoin · 0,15 SOL';
  }
}
</script>

</body>
</html>
